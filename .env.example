# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional: higher GitHub API limit for the portfolio import
GITHUB_TOKEN=

# Login for the web app (always set on Render)
APP_USERNAME=voiceprint
APP_PASSWORD=

# Shared mode: each browser only sees its own profile (on automatically on Render)
SHARED_MODE=0
